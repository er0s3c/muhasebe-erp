# syntax=docker/dockerfile:1
# Sürüm kitinden imaj: kaynak kod gerekmez; kitteki derlenmiş API + web + Linux üretim bağımlılıkları kopyalanır.
# Kurulum sihirbazı çalıştırır:  docker build -f installer/docker/Dockerfile.kit --build-arg NODE_MODULES=app/node_modules -t muhasebe-erp:<sürüm> .
# (Windows kitinde Linux bağımlılıkları docker/node_modules altındadır.) İçerik repodaki Dockerfile'ın çalışma zamanı aşamasıyla aynıdır.
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-bookworm-slim
ARG APP_VERSION=dev
ARG NODE_MODULES=app/node_modules
ENV NODE_ENV=production \
    APP_VERSION=${APP_VERSION} \
    PORT=3000 \
    WEB_DIST_DIR=/app/web \
    MIGRATIONS_DIR=/app/dist/drizzle \
    LICENSE_HOST_ID_FILE=/etc/host-machine-id
WORKDIR /app
COPY ${NODE_MODULES} ./node_modules
COPY installer/runtime /opt/construction-setup
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && python3 -m venv /opt/construction \
    && /opt/construction/bin/pip install --no-cache-dir -r /opt/construction-setup/requirements.txt \
    && /opt/construction/bin/python /opt/construction-setup/install-languages.py /opt/construction-tessdata \
    && mkdir -p /var/lib/erp-construction && chown node:node /var/lib/erp-construction \
    && rm -rf /var/lib/apt/lists/*
ENV CONSTRUCTION_PYTHON=/opt/construction/bin/python \
    CONSTRUCTION_TESSDATA_DIR=/opt/construction-tessdata \
    CONSTRUCTION_STORAGE_DIR=/var/lib/erp-construction
COPY app/dist ./dist
COPY app/web ./web
COPY app/THIRD-PARTY-NOTICES.md ./THIRD-PARTY-NOTICES.md
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server.js"]
