# Muhasebe ERP kurulum sihirbazı — yanıt dosyası örneği (etkileşimsiz kurulum)
#
# Sürüm kitinin klasöründe kullanılır (müşteri kurulumu). Kopyalayıp düzenleyin:
#   Linux/WSL : cp installer/answers.example ../musteri.answers && chmod 600 ../musteri.answers
#               ./install.sh --answers=../musteri.answers --dry-run      (sonra --dry-run olmadan)
#   Windows   : installer\install.ps1 -AnswersFile C:\yol\musteri.answers -DryRun
# Bu örnek olduğu gibi de geçerlidir: yerel (Docker'sız) yol, boş uygulama, e-postasız. Yalnızca YENİ kurulumda ya da
# --reconfigure ile okunur; kurulu sistemde düz kurulum yanıt dosyasını reddeder (yok saymaz).
#
# Biçim: ANAHTAR=değer (satır başına bir tane). # ile başlayan satırlar yorumdur. Değer boş bırakılırsa varsayılan kullanılır.
# Tırnaksız değerde baş/son boşluk atılır ve "boşluk + #" sonrası yorumdur; # ile başlayan değer yorumdur (boş = varsayılan).
# Değer #, " #" ya da baş/son boşluk içeriyorsa tırnak kullanın: SMTP_PASSWORD="a #b" ya da 'a #b' (içerik olduğu gibi alınır;
# kaçış dizisi yoktur, aynı tırnak karakteri değerde kullanılamaz). Dosya UTF-8'dir; BOM ve CRLF sorun değildir.
# Komut satırı bayrakları bu dosyadan önceliklidir. Dosya ÇALIŞTIRILMAZ (yalnızca okunur) ve hiçbir yere kopyalanmaz.
# DİKKAT: SMTP_PASSWORD ve LICENSE_CODE gizlidir; dosyayı chmod 600 yapın ve kurulum bitince SİLİN.
# Her anahtarın açıklaması: docs/OPERATIONS.md §2 (Kurulum soruları).

# --- Genel ---------------------------------------------------------------------------------------------------------------
MODE=prod                  # prod (müşteri kurulumu) | dev (geliştirme)
INSTALL_PATH=native        # docker | native
ACCESS=local               # local (yalnız bu bilgisayar) | lan (yerel ağ) | domain (alan adı + HTTPS)
PORT=3000                  # uygulama portu
DEMO=no                    # yes = demo verisi yüklenir | no = tamamen boş uygulama (üretimde varsayılan: no)
REGISTRATION=yes           # yes = "Kayıt ol" açık (ilk sahip hesabı için gerekli) | no = kapalı

# --- Lisans --------------------------------------------------------------------------------------------------------------
LICENSE_SERVER_URL=        # boş = kitteki varsayılan; yalnızca https://...
LICENSE_CODE=              # XXXXX-XXXXX-XXXXX-XXXXX-XXXXX (boş = tarayıcıda ilk açılışta girilir). GİZLİ

# --- E-posta (SMTP) ------------------------------------------------------------------------------------------------------
MAIL_ENABLED=no            # yes | no
SMTP_HOST=                 # örn. smtp.office365.com
SMTP_PORT=                 # boş = güvenlik türüne göre 465 / 587 / 25
SMTP_SECURITY=starttls     # ssl (465) | starttls (587) | none (şifresiz, önerilmez)
SMTP_USER=
SMTP_PASSWORD=             # GİZLİ
MAIL_FROM_ADDRESS=         # örn. no-reply@firma.com
MAIL_FROM_NAME=Muhasebe ERP
APP_BASE_URL=              # e-postalardaki bağlantı kökü; boş = alan adından/adresten türetilir
MAIL_TEST_TO=              # doluysa test e-postası gönderilir; başarısızsa kurulum DURUR (boş = test yok)

# --- Alan adı ve HTTPS (yalnızca Docker yolu) ------------------------------------------------------------------------------
TLS_MODE=                  # auto (Let's Encrypt) | byo (kendi sertifikanız) | selfsigned | none. Boş: domain=auto, diğerleri=none
DOMAIN=                    # örn. erp.firma.com (auto için FQDN) ya da LAN adresi 192.168.1.20
ACME_EMAIL=                # Let's Encrypt bildirim adresi (isteğe bağlı)
CERT_FILE=                 # byo: tam zincir sertifika (.crt/.pem) yolu
KEY_FILE=                  # byo: özel anahtar (.key) yolu — içeriği asla yazdırılmaz
HTTP_PORT=                 # varsayılan 80 (auto için sabit)
HTTPS_PORT=                # varsayılan 443 (auto için sabit)

# --- Yedekleme -----------------------------------------------------------------------------------------------------------
BACKUP_DIR=                # boş = /var/backups/muhasebe-erp (Linux yerel), ProgramData\MuhasebeERP\backups (Windows yerel), <kurulum>/backups (Docker)
BACKUP_KEEP=14             # saklanacak en yeni yedek sayısı (en az 1)
BACKUP_TIME=02:30          # günlük yedek saati (SS:DD)
