{
  "name": "@erp/license-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.license src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env.license src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env.license src/db/migrate-cli.ts",
    "cli": "tsx --env-file-if-exists=../../.env.license src/cli.ts",
    "build": "tsx scripts/build.ts"
  },
  "dependencies": {
    "@erp/license-core": "*",
    "@erp/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
