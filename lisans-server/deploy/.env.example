# Kopyalayın: cp lisans-server/deploy/.env.example lisans-server/deploy/.env   (asla depoya girmez; yedeğini AYRI ve şifreli saklayın)
# Parolalar URL-güvenli üretin:  openssl rand -hex 24

POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Yönetici TOTP sırlarını diskte şifreleyen ana sır:  openssl rand -base64 48
# Kaybolursa yöneticilerin TOTP'leri `cli admin:reset` ile yeniden kurulur.
LICENSE_DATA_KEY=

# İmza anahtarı: mühürlü dosyanın bulunduğu ana makine klasörü (içinde signing-key.json) ve parolası (≥ 12 karakter).
# Anahtarı `cli keygen` üretir; dosyayı ve parolayı AYRI yerlerde çevrimdışı yedekleyin.
# Dizin, kapta çalışan 'node' kullanıcısına (uid 1000) ait olmalı: chown 1000:1000 /etc/muhasebe-lisans && chmod 700 /etc/muhasebe-lisans
LICENSE_KEY_DIR=/etc/muhasebe-lisans
LICENSE_SIGNING_KEY_PASSPHRASE=

# Alan adı (DNS bu sunucuya yönlenmiş, 80/443 açık olmalı; tünel varyantında CNAME tünele) ve yönetim paneline izin verilen adresler (boşluk ayraçlı CIDR).
# Panelin https kökeni (https://${LICENSE_DOMAIN}) compose tarafından LICENSE_ADMIN_ORIGIN olarak verilir; giriş anahtarları bu köke bağlanır.
LICENSE_DOMAIN=admin.er0s3c.com
# LICENSE_ADMIN_ALLOW=203.0.113.7/32
# LICENSE_IMAGE=muhasebe-lisans:local
# APP_VERSION=1.0.0
# LOG_LEVEL=info

# Cloudflare Tunnel varyantı (docker-compose.tunnel.yml): config.yml + <tünel-id>.json içeren klasör (uid 65532 okuyabilmeli).
# CLOUDFLARED_DIR=/etc/muhasebe-lisans-tunnel

# Yeni kaynak kodsuz VPS kurulumu: tools/setup-vps.sh, Docker içinde yönetilen Tunnel.
# Token .env içine konmaz; korunan ayrı tunnel-token dosyasından okunur.
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
