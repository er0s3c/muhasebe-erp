# Çalışma zamanı bağlantısı: RLS'e tabi, DDL yetkisi olmayan rol (erp_app). Sahip rolünü buraya KOYMAYIN.
DATABASE_URL=postgres://erp_app:erp_app@localhost:5432/erp_dev
# Migration ve seed için şema sahibi rol (yalnızca db:migrate çalıştıran işlem kullanır; uygulama kabına verilmez)
MIGRATION_DATABASE_URL=postgres://erp:erp@localhost:5432/erp_dev
# En az 32 karakter. ÜRETİMDE rastgele üretin (openssl rand -base64 48); bu örnek değer üretimde reddedilir.
JWT_SECRET=dev-only-secret-change-me-please-32chars-min
PORT=3000

# --- İsteğe bağlı (tümü için varsayılanlar güvenlidir; ayrıntı: docs/OPERATIONS.md) ---
# Tarayıcı kökenleri (virgülle). Geliştirmede varsayılan http://localhost:5173; üretimde web arayüzü API ile
# aynı kökenden sunulduğundan boş bırakılır.
# CORS_ORIGIN=http://localhost:5173
# Ters vekil (Caddy/nginx) arkasında 1 verin; doğrudan internete açıkken false kalmalı.
# TRUST_PROXY=false
# Yenileme çerezi Secure bayrağı; varsayılan yalnızca NODE_ENV=production iken açık.
# COOKIE_SECURE=false
# Yeni kuruluş kaydı; özel kurulumda ilk sahip kaydından sonra false yapın.
# REGISTRATION_ENABLED=true
# LOG_LEVEL=info
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=0
