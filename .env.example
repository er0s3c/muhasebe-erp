# Çalışma zamanı bağlantısı: RLS'e tabi, DDL yetkisi olmayan rol (erp_app). Sahip rolünü buraya KOYMAYIN.
DATABASE_URL=postgres://erp_app:erp_app@localhost:5432/erp_dev
# Migration ve seed için şema sahibi rol (yalnızca db:migrate çalıştıran işlem kullanır; uygulama kabına verilmez)
MIGRATION_DATABASE_URL=postgres://erp:erp@localhost:5432/erp_dev
# En az 32 karakter. ÜRETİMDE rastgele üretin (openssl rand -base64 48); bu örnek değer üretimde reddedilir.
JWT_SECRET=dev-only-secret-change-me-please-32chars-min
PORT=3000

# --- İsteğe bağlı (tümü için varsayılanlar güvenlidir; ayrıntı: docs/OPERATIONS.md) ---
# Tarayıcı kökenleri (virgülle). Geliştirmede varsayılan http://localhost:5173; üretimde web arayüzü API ile
# aynı kökenden sunulduğundan boş bırakılır.
# CORS_ORIGIN=http://localhost:5173
# Ters vekil (Caddy/nginx/cloudflared) arkasında vekilin adresini kapsayan liste verin (ör. loopback,uniquelocal);
# doğrudan internete açıkken false kalmalı. Sayısal atlama değeri (1) kabul edilmez: Fastify 5 onu yok sayar.
# TRUST_PROXY=false
# Yenileme çerezi Secure bayrağı; varsayılan yalnızca NODE_ENV=production iken açık.
# COOKIE_SECURE=false
# Yeni kuruluş kaydı; özel kurulumda ilk sahip kaydından sonra false yapın.
# REGISTRATION_ENABLED=true
# LOG_LEVEL=info
# DB_POOL_MAX=20
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=60000   (0 = kapalı)
# EXPORT_CONCURRENCY=2
# E-posta (parola sıfırlama, e-posta doğrulama). Geliştirmede MAIL_TRANSPORT=log bağlantıyı API günlüğüne yazar.
# MAIL_TRANSPORT=log
# SMTP_URL=smtps://kullanici:parola@smtp.ornek.com:465
# MAIL_FROM="Muhasebe ERP <no-reply@ornek.com>"
# APP_BASE_URL=http://localhost:5173
# SESSION_MAX_DAYS=90
# Bildirim zamanlayıcısı (docs/OPERATIONS.md §9b): tarama aralığı (dk), kapanmış bildirim saklama süresi (gün), e-posta özeti saati (yerel)
# NOTIFY_ENABLED=true
# NOTIFY_INTERVAL_MINUTES=30
# NOTIFY_RETENTION_DAYS=90
# NOTIFY_DIGEST_HOUR=8

# Proje 360: dosya deposu veritabanıyla birlikte yedeklenmelidir (docs/CONSTRUCTION-360.md).
# CONSTRUCTION_STORAGE_DIR=data/construction
# CONSTRUCTION_JOBS_ENABLED=true
# CONSTRUCTION_PYTHON=python
# CONSTRUCTION_TESSDATA_DIR=data/construction-runtime/tessdata
# Dış AI yalnızca açık seçimle çağrılır; yerel kaynak araması bu ayarlar olmadan çalışır.
# CONSTRUCTION_AI_URL=https://hizmetiniz.example/v1/chat/completions
# CONSTRUCTION_AI_KEY=
# CONSTRUCTION_AI_MODEL=

# İşletim: üretimde PostgreSQL, geliştirmede bellek. Çok süreçte ortak limit sayacı.
# RATE_LIMIT_STORE=postgres
# Yedek ekranı: tek kuruluşa ait özel kurulumda kullanılır (docs/ENTERPRISE-EXPANSION.md).
# Yalnızca yedekleme işleyicisi bu bağlantıyı kullanır; DATABASE_URL daima erp_app kalır.
# BACKUP_DATABASE_URL=postgres://yedekleme_rolu:parola@localhost:5432/erp_dev
# BACKUP_DIRECTORY=data/backups
# BACKUP_SIGNING_KEY=ayri-rastgele-en-az-32-karakterlik-anahtar
# BACKUP_PG_BIN=C:/Program Files/PostgreSQL/16/bin
# Geliştirme testi için alternatif: Docker PostgreSQL istemcisi (üretimde kapalı).
# BACKUP_DOCKER_CONTAINER=muhasebe-erp-db-1
