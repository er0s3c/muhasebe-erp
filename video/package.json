{
  "name": "muhasebe-erp-tanitim-videosu",
  "version": "1.0.0",
  "private": true,
  "description": "Muhasebe ERP tanıtım videosu (Remotion). Ana uygulamadan bağımsızdır; kök npm çalışma alanlarına dahil değildir.",
  "scripts": {
    "studio": "remotion studio",
    "voice": "node scripts/make-voice.mjs",
    "render": "node scripts/render.mjs",
    "still": "remotion still src/index.ts Tanitim --scale=0.5",
    "typecheck": "tsc --noEmit",
    "shots": "tsx scripts/capture-shots.ts",
    "music": "node scripts/make-music.mjs",
    "build": "npm run voice && npm run music && npm run render"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
